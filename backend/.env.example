# ShopKart Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your actual credentials.
# Do not commit real credentials to version control.

# Server Port (Default is 5001 if omitted)
PORT=5001

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopkart?retryWrites=true&w=majority

# JWT Secret Key for signing customer authentication tokens (Use a secure, long random string)
JWT_SECRET=replace_with_a_strong_random_secret

# Razorpay Test Mode Credentials (From Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Credentials (Optional: used for product image migration script)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Frontend URL for additional CORS access (e.g. custom deployed frontend URL)
CLIENT_URL=https://shopkart-weld.vercel.app

